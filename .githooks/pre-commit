#!/usr/bin/env python3
"""Reject staged agent-authored files over 5,000 tokens (tokens = bytes / 4).

Checks the staged blob, not the working tree. Skips files no agent writes by
hand: binaries, lockfiles, minified bundles, vendored and generated code.
Mark other generated paths in .gitattributes with `linguist-generated`.
Bypass once with `git commit --no-verify` only for a deliberate exception.
"""

import fnmatch
import subprocess
import sys
from pathlib import PurePosixPath

MAX_TOKENS = 5_000
BYTES_PER_TOKEN = 4
MAX_BYTES = MAX_TOKENS * BYTES_PER_TOKEN

IGNORED_NAMES = {
    "package-lock.json", "npm-shrinkwrap.json", "yarn.lock", "pnpm-lock.yaml",
    "bun.lockb", "bun.lock", "Cargo.lock", "poetry.lock", "uv.lock", "Pipfile.lock",
    "Gemfile.lock", "composer.lock", "go.sum", "Podfile.lock", "pubspec.lock",
    "flake.lock", "mix.lock", "Package.resolved", "gradle.lockfile",
}
IGNORED_GLOBS = [
    "*.lock", "*.min.js", "*.min.css", "*.map", "*.snap", "*.pb.go", "*_pb2.py",
    "*_pb2.pyi", "*.g.dart", "*.freezed.dart", "*.generated.*", "*.gen.*",
    "*.svg", "*.ipynb",
]
IGNORED_DIRS = {
    "node_modules", "vendor", "third_party", "dist", "build", "generated",
    "__generated__", ".venv", "Pods",
}
GENERATED_MARKERS = (b"@generated", b"DO NOT EDIT", b"auto-generated", b"autogenerated")


def git(*args: str) -> bytes:
    return subprocess.run(["git", *args], check=True, capture_output=True).stdout


def staged_paths() -> list[str]:
    out = git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z")
    return [p for p in out.decode().split("\0") if p]


def binary_paths() -> set[str]:
    out = git("diff", "--cached", "--numstat", "--diff-filter=ACMR", "-z").decode()
    binaries = set()
    for record in out.split("\0"):
        parts = record.split("\t")
        if len(parts) == 3 and parts[0] == "-" and parts[1] == "-":
            binaries.add(parts[2])
    return binaries


def attr_generated(paths: list[str]) -> set[str]:
    if not paths:
        return set()
    out = git("check-attr", "-z", "linguist-generated", "--", *paths).decode().split("\0")
    return {out[i] for i in range(0, len(out) - 2, 3) if out[i + 2] in ("set", "true")}


def is_ignored_path(path: str) -> bool:
    p = PurePosixPath(path)
    if p.name in IGNORED_NAMES or IGNORED_DIRS.intersection(p.parts[:-1]):
        return True
    return any(fnmatch.fnmatch(p.name, g) for g in IGNORED_GLOBS)


def has_generated_marker(path: str) -> bool:
    head = git("cat-file", "blob", f":{path}")[:1024]
    return any(marker in head for marker in GENERATED_MARKERS)


SPLIT_HINTS = {
    ".py": "Move each cohesive group of functions/classes into its own module in a package "
           "(e.g. hub/networking.py -> hub/networking/{__init__,intake,scoring,drafts}.py). "
           "Keep the public names importable from the old path via __init__.py re-exports.",
    ".js": "Move each feature or view into its own ES module and import it "
           "(e.g. web/app.js -> web/app/{state,render,events,api}.js). "
           "Keep app.js as a thin entry point that wires the modules together.",
    ".ts": "Same as .js: one ES module per feature/responsibility, thin entry file re-exports.",
    ".css": "Split by component or page into separate stylesheets (tokens.css, layout.css, "
            "<component>.css) and load them from index.html or with @import.",
    ".md": "Split at the top-level headings into separate documents in a folder, and leave "
           "a short index in the original file that links to each part.",
    ".html": "Move inline <style> and <script> into separate files; split repeated sections "
             "into templates or components.",
}
SPLIT_HINTS[".tsx"] = SPLIT_HINTS[".jsx"] = SPLIT_HINTS[".mjs"] = SPLIT_HINTS[".ts"]


def report(offenders: list[tuple[str, int]]) -> str:
    lines = [
        "",
        f"pre-commit: {len(offenders)} staged file(s) exceed {MAX_TOKENS:,} tokens "
        f"(tokens = bytes / {BYTES_PER_TOKEN}, limit {MAX_BYTES:,} bytes).",
        "",
    ]
    for path, size in offenders:
        tokens = size // BYTES_PER_TOKEN
        parts = -(-size // MAX_BYTES)
        lines.append(f"  {path}: ~{tokens:,} tokens ({size:,} bytes) -> split into at least {parts} files")
    lines += [
        "",
        "How to split a file:",
        "  1. List the file's responsibilities: group functions, classes, sections or",
        "     rules that change together. Each group becomes one new file.",
        "  2. Aim for each new file to be well under the limit (about 3,000 tokens /",
        "     12 KB) so it has room to grow. Name each file after its responsibility,",
        "     not 'utils2' or 'part2'.",
        "  3. Move code verbatim first; do not rewrite logic in the same step.",
        "  4. Keep the original path working: turn it into an entry point or index that",
        "     imports/re-exports from the new files, so callers do not change.",
        "  5. Update imports, script tags and links, then run the tests:",
        "       python -m unittest discover -s tests -v",
        "  6. Stage the new files and the slimmed original, then commit again.",
        "",
        "By file type:",
    ]
    seen = set()
    for path, _ in offenders:
        ext = PurePosixPath(path).suffix.lower()
        hint = SPLIT_HINTS.get(ext)
        if hint and ext not in seen:
            seen.add(ext)
            lines.append(f"  {ext}: {hint}")
    if not seen:
        lines.append("  Split by responsibility as above.")
    lines += [
        "",
        "If the file is generated or not written by an agent, mark it in .gitattributes:",
        "  path/to/file linguist-generated",
        "",
    ]
    return "\n".join(lines)


def main() -> int:
    paths = staged_paths()
    skipped = binary_paths() | attr_generated(paths)
    offenders = []
    for path in paths:
        if path in skipped or is_ignored_path(path):
            continue
        try:
            size = int(git("cat-file", "-s", f":{path}"))
        except subprocess.CalledProcessError:
            continue  # submodule commit or other non-blob entry
        if size > MAX_BYTES and not has_generated_marker(path):
            offenders.append((path, size))
    if offenders:
        print(report(sorted(offenders, key=lambda o: -o[1])), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
